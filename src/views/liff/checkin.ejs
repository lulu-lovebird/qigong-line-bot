<!DOCTYPE html>
<html lang="zh-Hant">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>LINE 今日打卡</title>
  <script src="https://static.line-scdn.net/liff/edge/2/sdk.js"></script>
  <style>
    body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; margin: 0; background: #f6f7fb; color: #1f2937; }
    .container { max-width: 640px; margin: 0 auto; padding: 20px; }
    .card { background: #fff; border-radius: 14px; padding: 20px; box-shadow: 0 8px 24px rgba(0,0,0,.08); margin-bottom: 16px; }
    h1 { font-size: 24px; margin: 0 0 8px; }
    h2 { font-size: 16px; margin: 0 0 12px; }
    .muted { color: #6b7280; font-size: 14px; }
    .method-group { border-bottom: 1px solid #f3f4f6; padding: 6px 0; }
    .method-group:last-child { border-bottom: 0; }
    .method-row { display: flex; align-items: center; gap: 10px; }
    .method-label { display: flex; align-items: center; gap: 10px; flex: 1; padding: 8px 0; }
    .toggle-btn { width: 30px; height: 30px; border-radius: 8px; border: 1px solid #d1d5db; background: #fff; color: #374151; font-size: 18px; line-height: 1; padding: 0; flex-shrink: 0; }
    .toggle-spacer { width: 30px; height: 30px; flex-shrink: 0; }
    .child-list { margin-left: 40px; padding-bottom: 4px; }
    .child-row { display: flex; align-items: center; gap: 10px; padding: 6px 0; }
    .child-label { display: flex; align-items: center; gap: 10px; flex: 1; color: #4b5563; }
    .method-hint { color: #9ca3af; font-size: 12px; }
    .feeling-hint { margin: 10px 0 8px; }
    .feeling-tags { display: flex; flex-wrap: wrap; gap: 8px; }
    .feeling-tag { width: auto; padding: 8px 12px; border: 1px solid #86efac; border-radius: 999px; background: #f0fdf4; color: #166534; font-size: 14px; font-weight: 500; }
    .feeling-tag.selected { background: #06c755; border-color: #06c755; color: #fff; }
    textarea { width: 100%; min-height: 96px; border: 1px solid #d1d5db; border-radius: 10px; padding: 12px; font-size: 14px; box-sizing: border-box; }
    button { width: 100%; background: #06c755; color: #fff; border: 0; border-radius: 12px; padding: 14px; font-size: 16px; font-weight: 600; cursor: pointer; }
    button:disabled { background: #9ca3af; }
    .hint { background: #eff6ff; color: #1d4ed8; padding: 10px 12px; border-radius: 10px; font-size: 14px; }
    .status { margin-top: 12px; font-size: 14px; }
    .error { color: #b91c1c; }
    .success { color: #166534; }
    .settings-row { display:flex; justify-content:flex-end; margin-bottom:12px; }
    .timezone-setting { display:inline-flex; align-items:center; gap:5px; width:auto; max-width:100%; border:1px solid #d1d5db; border-radius:10px; background:#fff; color:#1f2937; padding:8px 10px; font-size:14px; font-weight:500; }
    .timezone-setting-label { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    .timezone-setting-action { color:#06a844; font-weight:700; }
    .timezone-card { border:1px solid #86efac; }
    .timezone-row { display:flex; gap:8px; align-items:center; }
    .timezone-input { flex:1; min-width:0; border:1px solid #d1d5db; border-radius:10px; background:#fff; padding:11px; font-size:14px; }
    .timezone-button { width:auto; padding:11px 14px; }
    .date-tabs { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr); gap:6px; margin-top:10px; padding:4px; border-radius:12px; background:#f3f4f6; }
    .date-tab { min-width:0; padding:9px 7px; border-radius:9px; background:transparent; color:#374151; font-size:13px; line-height:1.2; }
    .date-tab-main { display:block; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    .date-tab-sub { display:block; margin-top:3px; color:#6b7280; font-size:11px; font-weight:500; white-space:nowrap; }
    .date-tab.active { background:#06c755; color:#fff; }
    .date-tab.active .date-tab-sub { color:#dcfce7; }
    .date-tab.makeup.active { background:#b45309; }
    .date-tab.makeup.active .date-tab-sub { color:#fef3c7; }
    .makeup-hint { margin:8px 0 0; color:#92400e; font-size:12px; }
    .makeup-mode { border:2px solid #f59e0b; }
    @media (max-width:480px) { .container{padding:14px}.card{padding:16px;margin-bottom:12px}.timezone-row{align-items:stretch;flex-direction:column}.timezone-button{width:100%} }
  </style>
</head>
<body>
  <div class="container">
    <div class="settings-row"><button id="changeTimezone" class="timezone-setting" type="button" hidden><span aria-hidden="true">🌐</span><span id="timezoneLabel" class="timezone-setting-label"></span><span class="timezone-setting-action">變更</span></button></div>
    <div id="timezoneCard" class="card timezone-card" hidden>
      <h2>設定練功時區</h2>
      <p class="muted">練功日期與補登期限會依此時區計算，請確認後再打卡。</p>
      <div class="timezone-row"><select id="timezoneInput" class="timezone-input"></select><button id="saveTimezone" class="timezone-button" type="button">確認時區</button></div>
      <div id="timezoneStatus" class="status"></div>
    </div>
    <div class="card">
      <h1>練功打卡</h1>
      <p class="muted">請選擇練功日期與功法，並可選填心得與感受。</p>
      <div id="dateTabs" class="date-tabs" hidden><button id="todayTab" class="date-tab active" type="button"></button><button id="makeupTab" class="date-tab makeup" type="button"></button></div>
      <p id="makeupHint" class="muted makeup-hint"></p>
      <div class="hint" id="todayStatus">正在載入今日打卡資料...</div>
    </div>

    <div id="methodsCard" class="card" hidden>
      <h2>練習功法（可複選）</h2>
      <div id="methodsContainer"></div>
    </div>

    <div id="noteCard" class="card" hidden>
      <h2>練功心得與身體感受（選填）</h2>
      <textarea id="practiceNote" maxlength="1000" placeholder="記錄今天練功的心得、身體感受或其他體會..."></textarea>
      <p id="feelingTagsHint" class="muted feeling-hint" hidden>快速選擇感受（可複選）</p>
      <div id="feelingTags" class="feeling-tags"></div>
    </div>

    <button type="button" id="submitButton" hidden>完成打卡</button>
    <div id="submitStatus" class="status"></div>
  </div>

  <script>
    const LIFF_ID = '<%= liffId %>';
    const methodsContainer = document.getElementById('methodsContainer');
    const practiceNote = document.getElementById('practiceNote');
    const feelingTags = document.getElementById('feelingTags');
    const feelingTagsHint = document.getElementById('feelingTagsHint');
    const submitButton = document.getElementById('submitButton');
    const submitStatus = document.getElementById('submitStatus');
    const todayStatus = document.getElementById('todayStatus');
    const timezoneCard = document.getElementById('timezoneCard');
    const timezoneInput = document.getElementById('timezoneInput');
    const timezoneStatus = document.getElementById('timezoneStatus');
    const saveTimezone = document.getElementById('saveTimezone');
    const changeTimezone = document.getElementById('changeTimezone');
    const timezoneLabel = document.getElementById('timezoneLabel');
    const dateTabs = document.getElementById('dateTabs');
    const todayTab = document.getElementById('todayTab');
    const makeupTab = document.getElementById('makeupTab');
    const makeupHint = document.getElementById('makeupHint');
    const methodsCard = document.getElementById('methodsCard');
    const noteCard = document.getElementById('noteCard');
    let lineUserId = '';
    let displayName = '';

    const mergeLegacyNotes = (reflection = '', bodyFeeling = '') => {
      const reflectionText = reflection.trim();
      const bodyFeelingText = bodyFeeling.trim();
      if (reflectionText && bodyFeelingText) return `練功心得：${reflectionText}\n身體感受：${bodyFeelingText}`;
      return reflectionText || bodyFeelingText;
    };
    let practiceMethods = [];
    let selectedMethodIds = new Set();
    let expandedMethodIds = new Set();
    let practiceFeelingTags = [];
    let profileSettings = null;
    let selectedDate = '';
    let loadedDate = '';
    let detectedTimezone = '';
    const drafts = new Map();
    const timezoneGroups = [
      ['亞洲',[['Asia/Taipei','台北（台灣）'],['Asia/Hong_Kong','香港'],['Asia/Shanghai','上海／北京（中國）'],['Asia/Singapore','新加坡'],['Asia/Tokyo','東京（日本）'],['Asia/Seoul','首爾（韓國）']]],
      ['歐洲',[['Europe/London','倫敦（英國）'],['Europe/Paris','巴黎（法國）'],['Europe/Berlin','柏林（德國）']]],
      ['美洲',[['America/New_York','紐約（美國東岸）'],['America/Toronto','多倫多（加拿大東岸）'],['America/Chicago','芝加哥（美國中部）'],['America/Denver','丹佛（美國山區）'],['America/Los_Angeles','洛杉磯（美國西岸）'],['America/Vancouver','溫哥華（加拿大西岸）'],['Pacific/Honolulu','檀香山（夏威夷）']]],
      ['大洋洲',[['Australia/Sydney','雪梨（澳洲）'],['Australia/Melbourne','墨爾本（澳洲）'],['Pacific/Auckland','奧克蘭（紐西蘭）']]]
    ];

    const timezoneName = (zone) => timezoneGroups.flatMap((group) => group[1]).find((item) => item[0] === zone)?.[1] || zone;
    const renderTimezoneOptions = (selectedTimezone) => {
      timezoneInput.replaceChildren();
      const added = new Set();
      if (detectedTimezone) {
        const option = document.createElement('option'); option.value=detectedTimezone; option.textContent=`此裝置偵測到：${timezoneName(detectedTimezone)}`; timezoneInput.append(option); added.add(detectedTimezone);
      }
      timezoneGroups.forEach(([label,zones]) => { const group=document.createElement('optgroup');group.label=label;zones.forEach(([value,name])=>{if(added.has(value))return;const option=document.createElement('option');option.value=value;option.textContent=name;group.append(option);added.add(value);});if(group.children.length)timezoneInput.append(group); });
      if (selectedTimezone && !added.has(selectedTimezone)) { const option=document.createElement('option');option.value=selectedTimezone;option.textContent=selectedTimezone;timezoneInput.append(option); }
      timezoneInput.value=selectedTimezone||detectedTimezone||'Asia/Taipei';
    };

    const shortDate = (date) => date.slice(5).replace('-', '/');
    const isMakeupMode = () => profileSettings && selectedDate === profileSettings.yesterday;
    const renderDateTab = (button,label,detail) => { button.replaceChildren();const main=document.createElement('span');main.className='date-tab-main';main.textContent=label;const sub=document.createElement('span');sub.className='date-tab-sub';sub.textContent=detail;button.append(main,sub); };
    const renderDateControls = () => {
      timezoneLabel.textContent=`練功時區：${timezoneName(profileSettings.practiceTimezone)}`;
      changeTimezone.hidden=!profileSettings.confirmed;
      methodsCard.hidden=!profileSettings.confirmed;noteCard.hidden=!profileSettings.confirmed;submitButton.hidden=!profileSettings.confirmed;dateTabs.hidden=!profileSettings.confirmed;
      renderDateTab(todayTab,'今天',shortDate(profileSettings.today));
      renderDateTab(makeupTab,'補登',`${shortDate(profileSettings.yesterday)} · ${profileSettings.canMakeupYesterday?'12:00 前':'已截止'}`);
      makeupTab.disabled=!profileSettings.canMakeupYesterday;todayTab.classList.toggle('active',selectedDate===profileSettings.today);makeupTab.classList.toggle('active',selectedDate===profileSettings.yesterday);
      makeupHint.hidden=profileSettings.canMakeupYesterday;makeupHint.textContent=profileSettings.canMakeupYesterday?'':`昨天 ${shortDate(profileSettings.yesterday)} 的補登期限已於當地中午 12:00 結束。`;
      document.querySelector('.container').classList.toggle('makeup-mode',isMakeupMode());submitButton.textContent=isMakeupMode()?`完成 ${shortDate(selectedDate)} 補登`:`完成 ${shortDate(selectedDate||profileSettings.today)} 打卡`;
    };

    const noteLines = () => practiceNote.value.split('\n').map((line) => line.trim()).filter(Boolean);
    const renderFeelingTags = () => {
      feelingTags.replaceChildren();
      feelingTagsHint.hidden = practiceFeelingTags.length === 0;
      const lines = new Set(noteLines());
      practiceFeelingTags.forEach((tag) => {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = `feeling-tag${lines.has(tag.nameZh) ? ' selected' : ''}`;
        button.textContent = tag.nameZh;
        button.setAttribute('aria-pressed', String(lines.has(tag.nameZh)));
        button.addEventListener('click', () => toggleFeelingTag(tag.nameZh));
        feelingTags.append(button);
      });
    };

    const toggleFeelingTag = (label) => {
      const lines = practiceNote.value.split('\n');
      const existingIndex = lines.findIndex((line) => line.trim() === label);
      if (existingIndex >= 0) {
        lines.splice(existingIndex, 1);
        practiceNote.value = lines.join('\n').replace(/^\n+|\n+$/g, '');
      } else {
        const next = practiceNote.value.trim() ? `${practiceNote.value.replace(/\s+$/, '')}\n${label}` : label;
        if (next.length > practiceNote.maxLength) {
          setStatus(submitStatus, '心得與感受最多 1000 字，無法加入此標籤。', 'error');
          return;
        }
        practiceNote.value = next;
      }
      renderFeelingTags();
      practiceNote.focus();
    };

    practiceNote.addEventListener('input', renderFeelingTags);

    const setStatus = (el, message, className = '') => {
      el.textContent = message;
      el.className = `status ${className}`.trim();
    };

    const apiFetch = async (url, options = {}) => {
      const headers = new Headers(options.headers || {});
      headers.set('x-line-user-id', lineUserId);
      const accessToken = liff.getAccessToken();
      if (accessToken) headers.set('x-line-access-token', accessToken);
      if (!headers.has('Content-Type') && options.method && options.method !== 'GET') {
        headers.set('Content-Type', 'application/json');
      }
      
      const separator = url.includes('?') ? '&' : '?';
      const finalUrl = `${url}${separator}displayName=${encodeURIComponent(displayName)}`;
      
      const res = await fetch(finalUrl, { ...options, headers });
      if (!res.ok) {
        const body = await res.json().catch(() => ({ error: 'Request failed' }));
        throw new Error(body.error || 'Request failed');
      }
      return res.json();
    };

    const refreshProfile = async () => {
      profileSettings = await apiFetch('/line/api/liff/profile');
      renderDateControls();
      return profileSettings;
    };

    const snapshotDraft = () => {
      if (!loadedDate) return;
      drafts.set(loadedDate, { selectedMethodIds: [...selectedMethodIds], practiceNote: practiceNote.value });
    };

    const normalizeSelectedIds = (methods, selectedIds) => {
      const normalized = new Set();
      const incoming = new Set(selectedIds);

      methods.forEach((method) => {
        if (method.children && method.children.length > 0) {
          if (incoming.has(method.id)) {
            method.children.forEach((child) => normalized.add(child.id));
          }
          method.children.forEach((child) => {
            if (incoming.has(child.id)) normalized.add(child.id);
          });
          return;
        }

        if (incoming.has(method.id)) normalized.add(method.id);
      });

      return normalized;
    };

    const getParentSelectionState = (method) => {
      if (!method.children || method.children.length === 0) {
        return { checked: selectedMethodIds.has(method.id), indeterminate: false };
      }

      const selectedCount = method.children.filter((child) => selectedMethodIds.has(child.id)).length;
      return {
        checked: selectedCount === method.children.length,
        indeterminate: selectedCount > 0 && selectedCount < method.children.length
      };
    };

    const redrawMethods = () => {
      methodsContainer.innerHTML = '';
      practiceMethods.forEach((method) => {
        const group = document.createElement('div');
        group.className = 'method-group';

        const row = document.createElement('div');
        row.className = 'method-row';

        if (method.children && method.children.length > 0) {
          const toggleButton = document.createElement('button');
          toggleButton.type = 'button';
          toggleButton.className = 'toggle-btn';
          toggleButton.dataset.action = 'toggle';
          toggleButton.dataset.methodId = String(method.id);
          toggleButton.textContent = expandedMethodIds.has(method.id) ? '−' : '+';
          row.appendChild(toggleButton);
        } else {
          const spacer = document.createElement('span');
          spacer.className = 'toggle-spacer';
          row.appendChild(spacer);
        }

        const label = document.createElement('label');
        label.className = 'method-label';

        const checkbox = document.createElement('input');
        checkbox.type = 'checkbox';
        checkbox.dataset.action = 'parent-check';
        checkbox.dataset.methodId = String(method.id);

        const state = getParentSelectionState(method);
        checkbox.checked = state.checked;
        checkbox.indeterminate = state.indeterminate;

        const textWrap = document.createElement('div');
        textWrap.innerHTML = method.children && method.children.length > 0
          ? `${method.nameZh} <span class="method-hint">勾選即全選子招式</span>`
          : method.nameZh;

        label.appendChild(checkbox);
        label.appendChild(textWrap);
        row.appendChild(label);
        group.appendChild(row);

        if (method.children && method.children.length > 0 && expandedMethodIds.has(method.id)) {
          const childList = document.createElement('div');
          childList.className = 'child-list';

          method.children.forEach((child) => {
            const childRow = document.createElement('div');
            childRow.className = 'child-row';

            const childLabel = document.createElement('label');
            childLabel.className = 'child-label';

            const childCheckbox = document.createElement('input');
            childCheckbox.type = 'checkbox';
            childCheckbox.dataset.action = 'child-check';
            childCheckbox.dataset.methodId = String(child.id);
            childCheckbox.checked = selectedMethodIds.has(child.id);

            const childText = document.createElement('span');
            childText.textContent = child.nameZh;

            childLabel.appendChild(childCheckbox);
            childLabel.appendChild(childText);
            childRow.appendChild(childLabel);
            childList.appendChild(childRow);
          });

          group.appendChild(childList);
        }

        methodsContainer.appendChild(group);
      });
    };

    const getSelectedMethodIds = () => {
      const ids = [];
      practiceMethods.forEach((method) => {
        if (method.children && method.children.length > 0) {
          method.children.forEach((child) => {
            if (selectedMethodIds.has(child.id)) ids.push(child.id);
          });
        } else if (selectedMethodIds.has(method.id)) {
          ids.push(method.id);
        }
      });
      return ids;
    };

    const renderMethods = (methods, selectedIds = []) => {
      practiceMethods = methods;
      selectedMethodIds = normalizeSelectedIds(methods, selectedIds);
      expandedMethodIds = new Set(methods.filter((method) => {
        if (!method.children || method.children.length === 0) return false;
        return method.children.some((child) => selectedMethodIds.has(child.id)) || selectedIds.includes(method.id);
      }).map((method) => method.id));
      redrawMethods();
    };

    const applyCheckinData = (data) => {
      selectedDate = data.date;
      loadedDate = data.date;
      renderMethods(practiceMethods, data.selectedMethodIds);
      practiceNote.value = data.practiceNote || mergeLegacyNotes(data.reflectionNote, data.bodyFeelingNote);
      renderFeelingTags();
      renderDateControls();
      todayStatus.textContent = data.alreadyCheckedIn
        ? `${shortDate(data.date)} 已打卡，可在期限內修改內容。`
        : isMakeupMode() ? `${shortDate(data.date)} 尚未打卡，可於中午 12:00 前補登。` : `${shortDate(data.date)} 尚未打卡。`;
      drafts.set(data.date, { selectedMethodIds: [...selectedMethodIds], practiceNote: practiceNote.value, alreadyCheckedIn: data.alreadyCheckedIn });
    };

    const loadCheckinDate = async (date) => {
      snapshotDraft();
      selectedDate = date;
      renderDateControls();
      submitStatus.textContent = '';
      const draft = drafts.get(date);
      if (draft) {
        loadedDate = date;
        renderMethods(practiceMethods, draft.selectedMethodIds);
        practiceNote.value = draft.practiceNote;
        renderFeelingTags();
        todayStatus.textContent = draft.alreadyCheckedIn
          ? `${shortDate(date)} 已打卡，可在期限內修改內容。`
          : isMakeupMode() ? `${shortDate(date)} 尚未打卡，可於中午 12:00 前補登。` : `${shortDate(date)} 尚未打卡。`;
        return;
      }
      todayStatus.textContent = '正在載入打卡資料...';
      applyCheckinData(await apiFetch(`/line/api/liff/checkin?date=${encodeURIComponent(date)}`));
    };

    methodsContainer.addEventListener('click', (event) => {
      const toggleButton = event.target.closest('button[data-action="toggle"]');
      if (!toggleButton) return;

      const methodId = Number(toggleButton.dataset.methodId);
      if (expandedMethodIds.has(methodId)) {
        expandedMethodIds.delete(methodId);
      } else {
        expandedMethodIds.add(methodId);
      }
      redrawMethods();
    });

    methodsContainer.addEventListener('change', (event) => {
      const target = event.target;
      if (!(target instanceof HTMLInputElement)) return;

      if (target.dataset.action === 'parent-check') {
        const methodId = Number(target.dataset.methodId);
        const method = practiceMethods.find((item) => item.id === methodId);
        if (!method) return;

        if (method.children && method.children.length > 0) {
          method.children.forEach((child) => {
            if (target.checked) selectedMethodIds.add(child.id);
            else selectedMethodIds.delete(child.id);
          });
        } else if (target.checked) {
          selectedMethodIds.add(method.id);
        } else {
          selectedMethodIds.delete(method.id);
        }

        redrawMethods();
        return;
      }

      if (target.dataset.action === 'child-check') {
        const methodId = Number(target.dataset.methodId);
        if (target.checked) selectedMethodIds.add(methodId);
        else selectedMethodIds.delete(methodId);
        redrawMethods();
      }
    });

    const ensureLiffLogin = async () => {
      await liff.init({ liffId: LIFF_ID });

      if (!liff.isLoggedIn()) {
        todayStatus.textContent = '正在導向 LINE 登入...';
        todayStatus.className = 'hint';
        liff.login({ redirectUri: window.location.href });
        return false;
      }

      return true;
    };

    const load = async () => {
      try {
        const ready = await ensureLiffLogin();
        if (!ready) {
          return;
        }

        const profile = await liff.getProfile();
        lineUserId = profile.userId;
        displayName = profile.displayName || '';

        profileSettings = await apiFetch('/line/api/liff/profile');
        detectedTimezone = Intl.DateTimeFormat().resolvedOptions().timeZone || '';
        renderTimezoneOptions(profileSettings.confirmed ? profileSettings.practiceTimezone : (detectedTimezone || profileSettings.practiceTimezone));
        timezoneCard.hidden = profileSettings.confirmed;
        selectedDate = profileSettings.today;
        renderDateControls();
        if (!profileSettings.confirmed) return;

        const [methodsResp, todayResp, feelingTagsResp] = await Promise.all([
          apiFetch('/line/api/liff/practice-methods').catch((error) => { throw new Error(`功法列表載入失敗：${error.message}`); }),
          apiFetch(`/line/api/liff/checkin?date=${encodeURIComponent(selectedDate)}`).catch((error) => { throw new Error(`打卡資料載入失敗：${error.message}`); }),
          apiFetch('/line/api/liff/practice-feeling-tags').catch((error) => {
            console.error('快速感受標籤載入失敗：', error);
            return { tags: [] };
          })
        ]);

        practiceMethods = methodsResp.methods;
        practiceFeelingTags = feelingTagsResp.tags;
        applyCheckinData(todayResp);
      } catch (error) {
        const msg = error && error.message ? error.message : String(error);
        if (msg.includes('access_token')) {
          todayStatus.textContent = '尚未完成 LINE 登入，請在 LINE App 內重新開啟此打卡頁面。';
        } else {
          todayStatus.textContent = `載入失敗：${msg}`;
        }
        todayStatus.className = 'hint error';
      }
    };

    submitButton.addEventListener('click', async () => {
      const methodIds = getSelectedMethodIds();
      if (methodIds.length === 0) {
        setStatus(submitStatus, '請至少勾選一個功法。', 'error');
        return;
      }
      submitButton.disabled = true;
      setStatus(submitStatus, '正在儲存打卡資料...');

      try {
        const previousToday = profileSettings.today;
        await refreshProfile();
        if (previousToday !== profileSettings.today && selectedDate === previousToday) {
          throw new Error('當地日期已變更，請確認練功日期後再次送出。');
        }
        const selectedCount = methodIds.length;
        const result = await apiFetch('/line/api/liff/checkin', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json;charset=UTF-8'
          },
          body: JSON.stringify({
            methodIds: [...methodIds],
            methodIdsCsv: methodIds.join(','),
            methodCount: selectedCount,
            displayName,
            checkinDate: selectedDate,
            practiceNote: practiceNote.value,
            reflectionNote: practiceNote.value,
            bodyFeelingNote: ''
          })
        });
        const streakText = result.stats ? `｜連續 ${result.stats.currentStreak} 天｜總計 ${result.stats.totalCheckins} 天` : '';
        setStatus(submitStatus, `${result.entryKind === 'makeup' ? `${shortDate(result.date)} 補登成功：` : `${shortDate(result.date)} 打卡成功：`}${result.selectedMethods.join('、')}${streakText}`, 'success');
        todayStatus.textContent = `${shortDate(result.date)} 的${result.entryKind === 'makeup' ? '補登' : '打卡'}內容已儲存。`;

        const summaryLines = [
          result.entryKind === 'makeup' ? '✅ 補登成功' : '✅ 打卡成功',
          '',
          `練功日期：${result.date}`,
          `練習功法：${result.selectedMethods.join('、')}`
        ];

        if (result.stats) {
          summaryLines.push(`🔥 連續打卡：${result.stats.currentStreak} 天`);
          summaryLines.push(`⭐ 總打卡天數：${result.stats.totalCheckins} 天`);
        }

        if (result.unlockedBadges && result.unlockedBadges.length > 0) {
          summaryLines.push('');
          summaryLines.push('🎉 新解鎖成就：');
          result.unlockedBadges.forEach((badge) => {
            const yearText = badge.earnedYear && badge.earnedYear !== 0 ? ` (${badge.earnedYear}年)` : '';
            summaryLines.push(`${badge.emoji || '🏅'} ${badge.name}${yearText}`);
          });
        }

                if (result.coachFeedback) {
          summaryLines.push("");
          summaryLines.push("💡【教練體感小解析】");
          summaryLines.push(result.coachFeedback);
        }

        const summaryText = summaryLines.join('\n');

        if (liff.isInClient()) {
          try {
            await liff.sendMessages([{ type: 'text', text: summaryText }]);
            liff.closeWindow();
            return;
          } catch (sendError) {
            console.error('LIFF sendMessages failed:', sendError);
            setStatus(submitStatus, '打卡成功，但回傳聊天室失敗，請手動返回 LINE 查看。', 'success');
          }
        }
      } catch (error) {
        setStatus(submitStatus, `儲存失敗：${error.message}`, 'error');
      } finally {
        submitButton.disabled = false;
      }
    });

    todayTab.addEventListener('click', async () => {
      try { await refreshProfile(); await loadCheckinDate(profileSettings.today); }
      catch (error) { setStatus(submitStatus, `載入失敗：${error.message}`, 'error'); }
    });
    makeupTab.addEventListener('click', async () => {
      try {
        await refreshProfile();
        if (!profileSettings.canMakeupYesterday) throw new Error(`昨天 ${shortDate(profileSettings.yesterday)} 的補登期限已結束。`);
        await loadCheckinDate(profileSettings.yesterday);
      } catch (error) { setStatus(submitStatus, `載入失敗：${error.message}`, 'error'); }
    });
    changeTimezone.addEventListener('click', () => {
      if (!profileSettings) return;
      renderTimezoneOptions(profileSettings.practiceTimezone);
      timezoneCard.hidden = false;
      timezoneCard.scrollIntoView({ behavior:'smooth', block:'start' });
    });
    saveTimezone.addEventListener('click', async () => {
      saveTimezone.disabled = true;
      setStatus(timezoneStatus, '儲存中...');
      try {
        profileSettings = await apiFetch('/line/api/liff/profile/practice-timezone', { method:'PATCH', body:JSON.stringify({ timezone:timezoneInput.value }) });
        timezoneCard.hidden = profileSettings.confirmed;
        selectedDate = profileSettings.today;
        drafts.clear();
        renderDateControls();
        setStatus(timezoneStatus, '練功時區已儲存。', 'success');
        await load();
      } catch (error) {
        setStatus(timezoneStatus, `時區儲存失敗：${error.message}`, 'error');
      } finally { saveTimezone.disabled = false; }
    });

    load();
  </script>
</body>
</html>
