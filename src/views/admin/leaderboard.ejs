<%- include('../partials/header') %>

<div class="row">
    <div class="col-md-6">
        <div class="chart-container">
            <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
                <h5 class="mb-0"><%= i18n.total_checkins_full_list %></h5>
                <small class="text-muted">共 <%= totalsData.total %> 人｜每頁 20 人</small>
            </div>
            <% if (totalsData.rows.length === 0) { %>
                <p class="text-center text-muted my-5"><%= i18n.no_data %></p>
            <% } else { %>
                <table class="table table-striped table-hover align-middle">
                    <thead>
                        <tr>
                            <th style="width: 50px;">#</th>
                            <th><%= i18n.name %></th>
                            <th class="text-end"><%= i18n.days %></th>
                            <th class="text-end"><%= i18n.streak %></th>
                            <th class="text-end"><%= i18n.last_checkin_date %></th>
                        </tr>
                    </thead>
                    <tbody>
                        <% totalsData.rows.forEach(function(row, index) { %>
                        <tr>
                            <td class="text-muted"><%= ((totalsData.page - 1) * totalsData.limit) + index + 1 %></td>
                            <td class="fw-bold">
                                <a href="/line/admin-dashboard/method-analysis?period=30d&lang=<%= lang %>&userId=<%= encodeURIComponent(row.lineUserId) %>&name=<%= encodeURIComponent(row.displayName) %>" class="text-decoration-none fw-bold">
                                    <%= row.displayName %>
                                </a>
                            </td>
                            <td class="text-end text-primary fw-bold"><%= row.totalCheckins %></td>
                            <td class="text-end"><%= row.currentStreak %></td>
                            <td class="text-end text-muted"><%= row.lastCheckinDate || '-' %></td>
                        </tr>
                        <% }); %>
                    </tbody>
                </table>
                <div class="d-flex justify-content-between align-items-center mt-3 flex-wrap gap-2">
                    <a href="?period=<%= currentPeriod %>&limit=<%= currentLimit %>&page=<%= Math.max(1, totalsData.page - 1) %>&lang=<%= lang %>" class="btn btn-outline-primary <%= totalsData.page <= 1 ? 'disabled' : '' %>"><%= i18n.previous_page %></a>
                    <small class="text-muted">第 <%= totalsData.page %> / <%= totalsData.totalPages %> 頁</small>
                    <a href="?period=<%= currentPeriod %>&limit=<%= currentLimit %>&page=<%= Math.min(totalsData.totalPages, totalsData.page + 1) %>&lang=<%= lang %>" class="btn btn-outline-primary <%= totalsData.page >= totalsData.totalPages ? 'disabled' : '' %>"><%= i18n.next_page %></a>
                </div>
            <% } %>
        </div>
    </div>
    
    <div class="col-md-6">
        <div class="chart-container">
            <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
                <h5 class="mb-0"><%= i18n.top_streaks %></h5>
                <div class="btn-group" role="group" aria-label="Leaderboard limit selector">
                    <a href="?period=<%= currentPeriod %>&limit=10&page=<%= totalsData.page %>&lang=<%= lang %>" class="btn btn-outline-primary <%= currentLimit === 10 ? 'active' : '' %>">Top 10</a>
                    <a href="?period=<%= currentPeriod %>&limit=20&page=<%= totalsData.page %>&lang=<%= lang %>" class="btn btn-outline-primary <%= currentLimit === 20 ? 'active' : '' %>">Top 20</a>
                    <a href="?period=<%= currentPeriod %>&limit=30&page=<%= totalsData.page %>&lang=<%= lang %>" class="btn btn-outline-primary <%= currentLimit === 30 ? 'active' : '' %>">Top 30</a>
                </div>
            </div>
            <% if (data.streaks.length === 0) { %>
                <p class="text-center text-muted my-5"><%= i18n.no_data %></p>
            <% } else { %>
                <table class="table table-striped table-hover align-middle">
                    <thead>
                        <tr>
                            <th style="width: 50px;">#</th>
                            <th><%= i18n.name %></th>
                            <th class="text-end"><%= i18n.streak %></th>
                        </tr>
                    </thead>
                    <tbody>
                        <% data.streaks.forEach(function(row, index) { %>
                        <tr>
                            <td class="text-muted"><%= index + 1 %></td>
                            <td class="fw-bold">
                                <a href="/line/admin-dashboard/method-analysis?period=30d&lang=<%= lang %>&userId=<%= encodeURIComponent(row.lineUserId) %>&name=<%= encodeURIComponent(row.displayName) %>" class="text-decoration-none fw-bold">
                                    <%= row.displayName %>
                                </a>
                            </td>
                            <td class="text-end text-danger fw-bold"><%= row.maxStreak %></td>
                        </tr>
                        <% }); %>
                    </tbody>
                </table>
            <% } %>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
